{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-result-v1",
  "title": "Worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "message"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  }
}
